{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe-prompt-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "observability": {
    "enabled": true
  },
  // AUTH_VALUE is a runtime Secret (`wrangler secret put AUTH_VALUE`), not a vars entry.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VaultObject"]
    },
    {
      "tag": "v2-r2-snapshot-only",
      "deleted_classes": ["VaultObject"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "vibe-prompt-snapshots"
    }
  ]
}
