{
  "name": "vibe-prompt-worker",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "cloudflare": {
    "bindings": {
      "AUTH_VALUE": {
        "description": "Client sync password for this vault. Use a long random string. It is **not** a Cloudflare API Token and **not** the vault content password (`vaultPassword`)."
      }
    }
  },
  "scripts": {
    "start": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "secret": "wrangler secret put AUTH_VALUE"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "miniflare": "5.20260828.0-alpha"
  }
}
